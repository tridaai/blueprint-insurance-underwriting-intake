# Copy this file to .env in the repo root and fill in only what you use.
# The app loads .env automatically at startup (API, CLI, and demo).
# A variable set in the real environment always takes precedence over .env.
#
# THE STANDARD RUN IS A REAL PROVIDER API — that is how this agent is
# meant to run, and how enterprises run agents: set MODEL_BACKEND to
# anthropic or openai below and add your key. (Any OpenAI-compatible
# endpoint works via OPENAI_BASE_URL.)
# The mock backend exists only as a no-key smoke test of the plumbing;
# Ollama (below) is the local/sovereign alternative.

# Which model backend to use: anthropic | openai | ollama | mock
MODEL_BACKEND=anthropic

# Which retriever to use: keyword | semantic | hybrid
# RETRIEVER=keyword

# ---------------------------------------------------------------------------
# OpenAI (drafting with MODEL_BACKEND=openai; also the embeddings provider
# for RETRIEVER=semantic|hybrid — Anthropic has no embeddings API)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=<your-openai-key>
# OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint — Azure OpenAI, a LiteLLM
# gateway, Together, Groq, or another hosted/self-hosted compatible
# service. This one variable is the "other providers" switch.
# OPENAI_BASE_URL=https://your-endpoint.example/v1
# Embedding model for RETRIEVER=semantic|hybrid.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Anthropic (drafting with MODEL_BACKEND=anthropic)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=<your-anthropic-key>
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional: a custom Anthropic-compatible endpoint.
# ANTHROPIC_BASE_URL=https://your-endpoint.example

# ---------------------------------------------------------------------------
# NVIDIA NIM — the endpoints NVIDIA's own blueprints deploy on.
# Hosted API catalog (build.nvidia.com): OpenAI-compatible, use
# MODEL_BACKEND=openai with your NVIDIA API key:
#   OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#   OPENAI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct   (or another NIM model)
#   OPENAI_API_KEY=<your-nvapi-key>
# Self-hosted NIM container (enterprise deployment, GPU): same settings
# with OPENAI_BASE_URL=http://localhost:8000/v1 and the model your
# container serves.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Ollama — fully local real-LLM mode (MODEL_BACKEND=ollama).
# No API key: Ollama serves an OpenAI-compatible API on localhost.
# Setup: install Ollama, then `ollama pull llama3.1` (and
# `ollama pull nomic-embed-text` if you use RETRIEVER=semantic|hybrid —
# embeddings come from Ollama too in this mode).
# ---------------------------------------------------------------------------
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Shared / optional
# ---------------------------------------------------------------------------
# Request timeout (seconds) for provider API calls. Provider SDK retries
# are disabled in code, so a dead endpoint fails within this timeout
# instead of stalling on silent retries.
# LLM_TIMEOUT_SECONDS=60
# Resilience ceiling (seconds) per provider call at a pipeline node —
# the wrapper in resilience.py, above the per-request timeout above.
# A call past the ceiling becomes a clean provider error; the
# idempotent language steps (extract, classify, diagnose, options,
# verify, review) retry once. Drafting never retries.
# NODE_TIMEOUT_SECONDS=180
# Agentic diagnosis (provider mode): the diagnosis runs a bounded tool
# loop — the model may call search_guidelines / submission_facts /
# insured_history / broker_history before composing. This caps the tool
# calls per diagnosis (default 4, hard cap 6).
# DIAGNOSIS_MAX_TOOL_CALLS=4
# Bounded repair loop: when a draft fails the guardrails, redraft with
# the failure reasons fed back, then re-validate. On by default; set to
# off/0/false/no to disable. Max redraft attempts per run (hard cap 3).
# GUARDRAIL_REPAIR=on
# GUARDRAIL_REPAIR_MAX_ATTEMPTS=1
# Independent reviewer: a separate model call (or a second, disjoint
# checklist in mock mode) reviews the drafts after self-verification —
# packet completeness above all. On by default; REVIEWER=off disables
# the step. REVIEWER_MODEL points the review at a different model than
# the drafter (default: the run's).
# REVIEWER=on
# REVIEWER_MODEL=
# Per-run token budget (cost guardrail): once one run's provider tokens
# pass this cap, the remaining provider steps degrade to their
# deterministic paths — the run finishes, the trace notes the degraded
# steps, and telemetry reports {limit, used, exceeded}. Unset = off.
# RUN_TOKEN_BUDGET=
# Output routing (off by default): when set, a successful approval POSTs
# the approved packet JSON to this URL — your policy admin system /
# work queue / automation endpoint. Failures are recorded on the result
# as dispatch_status=failed and never undo the approval.
# ACTION_WEBHOOK_URL=
# ACTION_WEBHOOK_TIMEOUT_SECONDS=5
# Optional API-key gate for the API surface: when set, data endpoints
# require the X-API-Key header. Unset = open (local-dev default).
# API_KEY=
# Approval store location (SQLite). Default: .data/ in the repo root.
# STATE_DB_PATH=:memory: selects the in-memory store (tests).
# STATE_DB_PATH=
# Checkpointed gate: CHECKPOINTS=off disables the LangGraph checkpoint
# pause/resume at the underwriter gate (decisions still record in the
# store). CHECKPOINT_DB_PATH overrides the checkpoint database.
# CHECKPOINTS=on
# CHECKPOINT_DB_PATH=
# Model for the opt-in LLM-judge eval pack (evals/run_llm_evals.py);
# defaults to the backend's own model.
# LLM_JUDGE_MODEL=
# Local Chroma vector-store directory for RETRIEVER=semantic|hybrid
# when the vectordb extra is installed (git-ignored either way).
# CHROMA_DIR=.chroma
# CHROMA_HOST=            # set to talk to a Chroma server instead of the embedded store
# CHROMA_PORT=8000        # (the docker-compose local stack sets these for you)
